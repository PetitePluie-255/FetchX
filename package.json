{
  "name": "fetchx-workspace",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetitePluie-255/FetchX.git"
  },
  "homepage": "https://github.com/PetitePluie-255/FetchX#readme",
  "bugs": {
    "url": "https://github.com/PetitePluie-255/FetchX/issues"
  },
  "author": "PetitePluie-255",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "format": "prettier --write \"packages/*/{src,tests}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"packages/*/{src,tests}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm -r type-check",
    "commit": "cz",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "verify": "pnpm install --frozen-lockfile && pnpm -r test && pnpm lint && pnpm -r type-check && pnpm -r build",
    "release:fetchx": "pnpm verify && cd packages/fetchx && release-it",
    "release:logger": "pnpm verify && cd packages/plugin-logger && release-it",
    "release": "pnpm run release:fetchx"
  },
  "packageManager": "pnpm@10.12.4",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.5",
    "prettier": "^3.1.0",
    "release-it": "^19.0.5",
    "terser": "^5.44.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^1.0.0"
  }
}
