{
  "name": "@petite-pluie/fetchx",
  "version": "0.2.0",
  "description": "A modern HTTP client library based on fetch API with axios-like interface",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetitePluie-255/FetchX.git"
  },
  "homepage": "https://github.com/PetitePluie-255/FetchX#readme",
  "bugs": {
    "url": "https://github.com/PetitePluie-255/FetchX/issues"
  },
  "author": "PetitePluie-255",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "fetch",
    "http",
    "client",
    "axios",
    "typescript",
    "request",
    "interceptor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "typescript": ">=4.9.0"
  }
}
