{
  "name": "@petite-pluie/fetchx-logger",
  "version": "0.0.0",
  "description": "Logger plugin for FetchX HTTP client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetitePluie-255/FetchX.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "fetchx",
    "plugin",
    "logger"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@petite-pluie/fetchx": ">=0.1.0",
    "typescript": ">=4.9.0"
  },
  "devDependencies": {
    "@petite-pluie/fetchx": "workspace:*"
  }
}
